HOST=0.0.0.0
PORT=1337
APP_KEYS="toBeModified1,toBeModified2"
API_TOKEN_SALT=tobemodified
ADMIN_JWT_SECRET=tobemodified
TRANSFER_TOKEN_SALT=tobemodified
JWT_SECRET=tobemodified
ENCRYPTION_KEY=tobemodified

# ── F2.7 — RAG (grounded AI co-pilot) ────────────────────────────────────
# Embedding provayderi. Provayder-agnostikdir: `RAG_EMBED_PROVIDER` dəyişməklə
# kodda heç nə redaktə etmədən başqa provaydere keçmək olar.
RAG_EMBED_PROVIDER=gemini
RAG_EMBED_MODEL=gemini-embedding-001
# DİQQƏT: ölçü DDL-də sabitlənir (`vector(768)`). Dəyişdirilsə indeks
# yenidən qurulmalıdır: rag-index.mjs --purge-hard, sonra --run
RAG_EMBED_DIMS=768
RAG_EMBED_BATCH=50
RAG_EMBED_TIMEOUT_MS=60000
GEMINI_API_KEY=
# E-poçt/telefon indeksləmə zamanı silinsin (defolt: true).
RAG_SCRUB_CONTACTS=true
# F2.7-2 — hibrid axtarış. Defolt BAĞLI: hər sorğu pullu embedding çağırışıdır
# və guardrails F2.7-3-dədir. Açmaq üçün: true
RAG_SEARCH_PUBLIC=false
# RRF çəkiləri. Vektor qolu Azərbaycan dilində zəif çıxarsa RAG_W_VECTOR
# azaldılır — indeksi yenidən qurmağa ehtiyac yoxdur.
RAG_W_LEXICAL=1
RAG_W_VECTOR=1
# Vektor kəsimi — üç mexanizm, hamısı defolt SÖNÜLÜ (0).
#
# PROD ÖLÇÜSÜ: Gemini kosinusu sıfır ətrafında mərkəzlənmir. Cəfəngiyat
# sorğusunda 60 namizədin hamısı 0.551…0.577 zolağında oturdu — fərq 0.026.
# Yəni MÜTLƏQ hədlər bu paylanmada faydasızdır.
#
# ƏSAS MEXANİZM: RAG_SIM_Z — namizədlərin öz paylanmasına görə küy səviyyəsi
# hesablanır, yalnız ondan `z` standart sapma yuxarıda olan nəticə saxlanılır.
# Miqyasdan asılı deyil. Kalibrləmək üçün:
#   node rag-index.mjs --search "<real sual>"        -> gapZ
#   node rag-index.mjs --search "kvant qara delik"   -> gapZ
# İki gapZ arasındakı sərhədi bura yaz (tipik başlanğıc: 2.5–4).
RAG_SIM_Z=0
# Nisbi fərq: ən yaxşıdan bu qədər geri qalanı at.
RAG_SIM_DROP=0
# Mütləq hədd.
RAG_SIM_FLOOR=0
# F2.7-1a — kvota tənzimləməsi.
# DİQQƏT: kvota HTTP sorğusunu YOX, hər MƏTN ELEMENTİNİ sayır — batch-i
# böyütmək kvotaya qənaət etmir. RPM = element/dəqiqə.
RAG_EMBED_RPM=90
RAG_EMBED_RETRIES=6
# F2.7-3 — guardrails. Hamısı defolt AÇIQDIR.
# FIN / IBAN / kart / pasport / doğum tarixi silinsin (kontekstə lövbərlənib).
RAG_SCRUB_IDENTIFIERS=true
# İnyeksiya naxışları aşkarlansın və parça işarələnsin.
RAG_GUARD_INJECTION=true
# İşarələnmiş parçalar axtarış nəticəsindən çıxarılsın.
RAG_DROP_FLAGGED=true

# ── F2.7-4 — cavab generasiyası ──────────────────────────────────────────
RAG_CHAT_PROVIDER=gemini
# MODEL ADI SÜRÜŞƏNDİR: Google 2.5 seriyasını elan olunmuş bağlanma
# tarixindən əvvəl yeni açarlara bağladı (404 «no longer available to new
# users»). Ad env-dədir — dəyişəndə kod toxunulmur.
RAG_CHAT_MODEL=gemini-3.5-flash
RAG_CHAT_MAX_TOKENS=800
RAG_CHAT_TEMPERATURE=0.2
RAG_CHAT_TIMEOUT_MS=45000
RAG_CHAT_RETRIES=3
# Prompta düşən sübut mətninin ümumi həcmi (simvol).
RAG_CONTEXT_CHARS=6000
# Defolt BAĞLI — hər sorğu pullu generasiyadır.
RAG_ANSWER_PUBLIC=false
# F2.7-5 — varlıq (NER) qolunun RRF çəkisi. Dəqiq ad uyğunluğu ehtimal
# əsaslı iki qoldan güclüdür, ona görə defolt 1.5-dir.
RAG_W_ENTITY=1.5
# F2.7-6b — bir HTTP sorğusu daxilində tənzimləyicinin gözləmə həddi.
# Bundan artıq lazım gələrsə iş yarımçıq qaytarılır (bağlantı qırılmasın).
RAG_EMBED_MAX_WAIT_MS=20000
# Sitatsız cavab üçün bir təmir cəhdi.
RAG_CITATION_REPAIR=true

HOST=0.0.0.0
PORT=1337
APP_KEYS="toBeModified1,toBeModified2"
API_TOKEN_SALT=tobemodified
ADMIN_JWT_SECRET=tobemodified
TRANSFER_TOKEN_SALT=tobemodified
JWT_SECRET=tobemodified
ENCRYPTION_KEY=tobemodified

# ── F2.7 — RAG (grounded AI co-pilot) ────────────────────────────────────
# Embedding provayderi. Provayder-agnostikdir: `RAG_EMBED_PROVIDER` dəyişməklə
# kodda heç nə redaktə etmədən başqa provaydere keçmək olar.
RAG_EMBED_PROVIDER=gemini
RAG_EMBED_MODEL=gemini-embedding-001
# DİQQƏT: ölçü DDL-də sabitlənir (`vector(768)`). Dəyişdirilsə indeks
# yenidən qurulmalıdır: rag-index.mjs --purge-hard, sonra --run
RAG_EMBED_DIMS=768
RAG_EMBED_BATCH=50
RAG_EMBED_TIMEOUT_MS=60000
GEMINI_API_KEY=
# E-poçt/telefon indeksləmə zamanı silinsin (defolt: true).
RAG_SCRUB_CONTACTS=true

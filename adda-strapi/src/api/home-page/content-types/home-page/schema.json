      "type": "text",
      "maxLength": 400
    },
    "quoteRu": {
      "type": "text",
      "maxLength": 400
    },
    "quoteAttr": {
      "type": "string",
      "maxLength": 120
    },
    "quoteAttrEn": {
      "type": "string",
      "maxLength": 120

{
  "kind": "collectionType",
  "collectionName": "people",
  "info": {
    "singularName": "person",
    "pluralName": "people",
    "displayName": "2. Akademiya — Heyət",
    "description": "Professor-müəllim, inzibati və texniki heyət"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {
    "i18n": {
      "localized": false
    }
  },
  "attributes": {
    "name": {
      "type": "string",
      "required": true
    },
    "displayName": {
      "type": "string"
    },
    "profileUpdatedAt": {
      "type": "datetime"
    },
    "slug": {
      "type": "uid",
      "targetField": "name",
      "required": true
    },
    "staffType": {
      "type": "enumeration",
      "enum": [
        "akademik",
        "telimci_texniki",
        "inzibati",
        "rehberlik",
        "diger"
      ],
      "default": "akademik"
    },
    "position": {
      "type": "string"
    },
    "positionRu": {
      "type": "string"
    },
    "positionEn": {
      "type": "string"
    },
    "academicTitle": {
      "type": "string"
    },
    "academicTitleRu": {
      "type": "string"
    },
    "academicTitleEn": {
      "type": "string"
    },
    "academicDegree": {
      "type": "enumeration",
      "enum": [
        "elmler_doktoru",
        "felsefe_doktoru",
        "elmler_namizedi",
        "yoxdur"
      ]
    },
    "roles": {
      "type": "component",
      "repeatable": true,
      "component": "staff.role"
    },
    "bio": {
      "type": "richtext"
    },
    "bioRu": {
      "type": "richtext"
    },
    "bioEn": {
      "type": "richtext"
    },
    "languages": {
      "type": "component",
      "repeatable": true,
      "component": "staff.language"
    },
    "scholar": {
      "type": "component",
      "repeatable": false,
      "component": "staff.scholar"
    },
    "researchAreas": {
      "type": "component",
      "repeatable": true,
      "component": "staff.tag"
    },
    "teaching": {
      "type": "richtext"
    },
    "publications": {
      "type": "component",
      "repeatable": true,
      "component": "staff.publication"
    },
    "experience": {
      "type": "component",
      "repeatable": true,
      "component": "staff.experience"
    },
    "education": {
      "type": "component",
      "repeatable": true,
      "component": "staff.education"
    },
    "responsibilities": {
      "type": "richtext"
    },
    "other": {
      "type": "richtext"
    },
    "photo": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images"
      ]
    },
    "email": {
      "type": "email"
    },
    "altEmail": {
      "type": "email"
    },
    "phone": {
      "type": "string"
    },
    "office": {
      "type": "string"
    },
    "building": {
      "type": "string"
    },
    "faculty": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::faculty.faculty",
      "inversedBy": "people"
    },
    "department": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::department.department",
      "inversedBy": "people"
    },
    "unit": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::unit.unit",
      "inversedBy": "people"
    },
    "headOf": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::unit.unit",
      "mappedBy": "head"
    },
    "articles": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::article.article",
      "mappedBy": "person"
    },
    "announcements": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::announcement.announcement",
      "mappedBy": "person"
    },
    "events": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::event.event",
      "mappedBy": "person"
    }
  }
}

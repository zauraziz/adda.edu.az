{
  "kind": "collectionType",
  "collectionName": "documents",
  "info": {
    "singularName": "document",
    "pluralName": "documents",
    "displayName": "1. Məzmun — Sənəd",
    "description": "Normativ-hüquqi sənədlər, əsasnamələr, hesabatlar"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {
    "i18n": {
      "localized": false
    }
  },
  "attributes": {
    "title": {
      "type": "string",
      "required": true
    },
    "titleRu": {
      "type": "string"
    },
    "titleEn": {
      "type": "string"
    },
    "description": {
      "type": "text",
      "maxLength": 500
    },
    "descriptionRu": {
      "type": "text",
      "maxLength": 500
    },
    "descriptionEn": {
      "type": "text",
      "maxLength": 500
    },
    "category": {
      "type": "enumeration",
      "enum": [
        "normativ",
        "esasname",
        "emr",
        "qerar",
        "hesabat",
        "etika",
        "akkreditasiya",
        "forma",
        "diger"
      ],
      "default": "diger",
      "required": true
    },
    "file": {
      "type": "media",
      "multiple": false,
      "required": true
    },
    "year": {
      "type": "integer",
      "min": 1881,
      "max": 2100
    },
    "units": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::unit.unit",
      "inversedBy": "documents"
    },
    "programs": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::program.program",
      "inversedBy": "documents"
    }
  }
}
